# Database
DATABASE_URL="postgresql://username:password@localhost:5432/dental_clinic?schema=public"

# JWT
JWT_SECRET="your-super-secret-jwt-key-change-this-in-production"
JWT_REFRESH_SECRET="your-super-secret-refresh-key-change-this-in-production"
JWT_ACCESS_EXPIRATION="15m"
JWT_REFRESH_EXPIRATION="7d"

# Server
PORT=399
NODE_ENV=development

# CORS
CORS_ORIGIN="http://localhost:5173"
FRONTEND_URL="http://localhost:5173"

# SMTP
SMTP_HOST="smtp.example.com"
SMTP_PORT=587
SMTP_USER="your-smtp-user"
SMTP_PASS="your-smtp-password"
SMTP_FROM="Dental Clinic <no-reply@example.com>"
SMTP_SECURE=false

# Clinic Settings
CLINIC_NAME="Smile Care Dental Clinic"
CLINIC_TIMEZONE="America/New_York"

# Messaging (example defaults - update later as needed)
# Enables/disables in-app secure messaging endpoints
MESSAGING_ENABLED=true
# Patients can only message staff when true
MESSAGING_ALLOW_PATIENT_TO_STAFF=true
# Staff can message patients when true
MESSAGING_ALLOW_STAFF_TO_PATIENT=true
# Optional default signature appended by UI templates
MESSAGING_DEFAULT_SIGNATURE="Thanks, Dental Clinic Team"
